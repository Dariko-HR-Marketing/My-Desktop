# Copy to /opt/my-desktop/deploy/.env on the server (setup-server.sh does this and fills in secrets).
DOMAIN=my-desk.tajriba24.uz
POSTGRES_PASSWORD=
JWT_SECRET=
# base64 of 32 random bytes: `openssl rand -base64 32`. Encrypts integration keys (AI, Telegram…) in the database.
# Keep a backup: if it is lost, saved integration keys must be entered again.
INTEGRATIONS_KEY=
SEED_ADMIN_PASSWORD=
JWT_EXPIRES_IN=12h
CORS_ORIGINS=tauri://localhost,http://tauri.localhost
