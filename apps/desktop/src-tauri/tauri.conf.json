{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ish maydoni",
  "version": "0.1.0",
  "identifier": "uz.ishmaydoni.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ish maydoni",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
