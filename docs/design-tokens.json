{
  "$description": "Ish maydoni dizayn tokenlari. styles/tokens.css shu fayldan yaratiladi: :root (light), [data-theme=dark], [data-density=compact].",
  "font": {
    "sans": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, Consolas, monospace"
  },
  "type": {
    "display": { "size": 28, "weight": 600, "lineHeight": 1.2, "letterSpacing": "-0.01em" },
    "title": { "size": 20, "weight": 600, "lineHeight": 1.3 },
    "section": { "size": 17, "weight": 600, "lineHeight": 1.35 },
    "body": { "size": 14, "weight": 400, "lineHeight": 1.5 },
    "caption": { "size": 12, "weight": 500, "lineHeight": 1.4 },
    "overline": { "size": 11, "weight": 600, "letterSpacing": "0.08em", "transform": "uppercase" },
    "kpi": { "size": 28, "weight": 600, "lineHeight": 1 }
  },
  "space": [4, 8, 12, 16, 20, 24, 28, 32, 48],
  "radius": { "sm": 6, "md": 10, "lg": 12, "xl": 14, "pill": 999 },
  "size": {
    "control": { "comfortable": 44, "compact": 36 },
    "row": { "comfortable": 52, "compact": 40 },
    "navItem": { "comfortable": 40, "compact": 36 },
    "sidebar": { "full": 248, "collapsed": 72 },
    "topbar": 68,
    "bottomNav": 76,
    "contentMax": 1240,
    "drawer": 440,
    "palette": 640
  },
  "breakpoints": { "phone": 0, "tablet": 600, "laptop": 1024, "desktop": 1280 },
  "grid": {
    "desktop": { "columns": 12, "gutter": 24, "margin": 32 },
    "laptop": { "columns": 12, "gutter": 24, "margin": 24 },
    "tablet": { "columns": 8, "gutter": 16, "margin": 24 },
    "phone": { "columns": 4, "gutter": 16, "margin": 16 }
  },
