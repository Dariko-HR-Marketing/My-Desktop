{
  "name": "ish-maydoni",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w @ish-maydoni/server",
    "dev:desktop": "npm run dev -w @ish-maydoni/desktop",
    "tauri:dev": "npm run tauri -w @ish-maydoni/desktop -- dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @ish-maydoni/shared && npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "pretypecheck": "npm run build -w @ish-maydoni/shared",
    "pretest": "npm run build -w @ish-maydoni/shared",
    "predev:server": "npm run build -w @ish-maydoni/shared"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "rollup": "4.65.1"
  }
}
